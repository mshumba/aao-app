# Copy to .env (git-ignored) and fill in. EXPO_PUBLIC_* values are bundled
# into the app and are public by design; never put a service_role key here.

# Supabase project → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sign-in buttons to show, comma-separated: apple,google,email (and
# apple-web for Apple on the web/Android, which needs an Apple Services ID).
# Leave a method out until its provider is enabled in Supabase.
EXPO_PUBLIC_AUTH_METHODS=apple,google,email

# Google OAuth client IDs (Google Cloud → APIs & Services → Credentials),
# public by design. iPhone builds with the native Google module sign in with
# Google's own sheet using the iOS client; the web client is the one
# Supabase's Google provider runs on. Both must be listed in Supabase →
# Authentication → Providers → Google → Client IDs. Without them, Google
# sign-in uses the web flow.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Never passed to Google (Android finds its client by package name and
# SHA-1). Set it only once an Android OAuth client with the build's SHA-1
# exists: with the web client ID above, it turns on Google's own sheet on
# Android. Until then Android uses the web flow.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Public web address for share links (no trailing slash).
EXPO_PUBLIC_WEB_URL=https://aao-app.expo.app

# Development only: "local" forces the on-device stand-in account service
# even when Supabase is configured (the automated tests use it).
# EXPO_PUBLIC_AUTH_MODE=local

# Sentry project DSN (Sentry → Project settings → Client keys). Public by design.
EXPO_PUBLIC_SENTRY_DSN=
