{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
