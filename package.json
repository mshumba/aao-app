{
  "name": "aao-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "test:catalog": "playwright test tests/catalog.spec.ts tests/catalogue.spec.ts tests/parseTitle.spec.ts",
    "catalogue:import": "node --env-file=.env scripts/import-catalogue.mts",
    "export:all": "expo export --platform all --output-dir dist",
    "icons": "node assets/icon-source/render.mjs",
    "ios:simulator": "eas build -p ios --profile simulator",
    "build:testflight": "eas build -p ios --profile production --auto-submit",
    "update:preview": "eas update --channel preview --environment preview"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/vector-icons": "^15.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  }
}
